<mjml>
  <mj-head>
    <mj-title>2026-27 University Budget Update</mj-title>
    <mj-attributes>
      <mj-text font-family="Arial, sans-serif" font-size="15px" color="#004C46" line-height="20px" />
      <mj-all font-family="Arial" />
      <mj-section padding="30px 0 0 0" />
      <mj-button background-color="#004C46" color="#FFF" border="2px solid #FFF" font-size="16px" border-radius="15px" font-weight="bold" letter-spacing="1px" />
      <mj-divider border-width="1px" />

    </mj-attributes>
    <mj-style inline="inline"> h2 { line-height: 28px; } a { color: #864e27; } a.dark { color: #004C46; } li { padding-bottom: 10px; } .dark-wrap { background: #004C46; color: #fff; } .light-wrap { background: #FFFFFF; } @media only screen and (max-width: 420px) { .caption div { text-align: center !important; } } </mj-style>
  </mj-head>
  <mj-body background-color="#E9E3D0">
    <mj-section padding="40px 0 0">
      <mj-column>
        <!-- wordmark on right -->
        <!-- <mj-image src="https://mailings.humboldt.edu/polytechnic/img/header-right.png" alt="Cal Poly Humboldt" padding="0" /> -->
        <!-- wordmark on left -->
        <mj-image src="https://mailings.humboldt.edu/polytechnic/img/emailHeader-09262022.png" alt="Cal Poly Humboldt" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section css-class="light-wrap">
      <mj-column>
        <mj-text padding-top="0">
          <h1 style="color:#004C45;font-size:18px;font-weight:bold;margin:0;text-align: left;"> A Message from the Cal Poly Humboldt</h1>
          <p id="date" style="color:#004C45;font-size:14px;font-weight:bold;margin:10px 0 20px 0;text-align: left;">August 17, 2026</p>
          <p style="color:#004C45;font-size:22px;font-weight:bold;margin:10px 0 20px 0; line-height:28px">2026-27 University Budget Update
          </p>
        </mj-text>
        <mj-divider border-color="#F2A900" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section css-class="light-wrap" padding-bottom="20px" padding-top="20px">
      <mj-column>
        <mj-table cellpadding="0" cellspacing="0" width="100%" css-class="budget-table">
          <caption style="font-weight: bold; font-size: 16px; padding-bottom: 12px; color: #111111; text-align: center;">2026-27</caption>
          <thead>
            <tr style="background-color: #004c46; color: #FFFFFF;">
              <th scope="col" style="padding: 10px; text-align: center; font-weight: bold;">Incremental Changes</th>
              <th scope="col" colspan="2" style="padding: 10px; text-align: center; font-weight: bold;">Incremental Changes</th>
            </tr>
            <tr style="background-color: #004C46; color: #FFFFFF;">

              <th scope="col" style="padding: 10px; text-align: right; font-weight: bold;">&nbsp;</th>
              <th scope="col" style="padding: 10px; text-align: center; font-weight: bold;">URPC Recommendation</th>
              <th scope="col" style="padding: 10px; text-align: center; font-weight: bold;">Final Budget</th>
            </tr>
          </thead>
          <tbody>
            <!-- Prior Year Revenue -->
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Prior Year Revenue/Sources Budget</th>
              <td style="padding: 10px; text-align: right;">$175,270,821</td>
              <td style="padding: 10px; text-align: right;">$175,270,821</td>
            </tr>

            <!-- SECTION HEADER: State General Fund -->
            <tr style="background-color: #EDF2F7; border-bottom: 1px solid #CBD5E0;">
              <th scope="row" colspan="3" style="padding: 10px; text-align: left; font-weight: bold; color: #2D3748;">State General Fund:</th>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px 10px 10px 20px; text-align: left; font-weight: normal; color: #4A5568;">Restoration of 2025-26 Cut to CSU</th>
              <td style="padding: 10px; text-align: right;">$3,040,000</td>
              <td style="padding: 10px; text-align: right;">$0</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px 10px 10px 20px; text-align: left; font-weight: normal; color: #4A5568;">Enrollment Reallocation</th>
              <td style="padding: 10px; text-align: right; color: #C53030;">($3,378,000)</td>
              <td style="padding: 10px; text-align: right; color: #C53030;">($3,385,000)</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px 10px 10px 20px; text-align: left; font-weight: normal; color: #4A5568;">Polytechnic Allocation</th>
              <td style="padding: 10px; text-align: right;">$3,729,000</td>
              <td style="padding: 10px; text-align: right;">$3,729,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px 10px 10px 20px; text-align: left; font-weight: normal; color: #4A5568;">New State General Fund Allocation</th>
              <td style="padding: 10px; text-align: right;">$4,549,000</td>
              <td style="padding: 10px; text-align: right;">$2,991,000</td>
            </tr>

            <!-- Tuition Rows -->
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Tuition: Enrollment Growth</th>
              <td style="padding: 10px; text-align: right;">$2,681,000</td>
              <td style="padding: 10px; text-align: right;">$1,601,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Tuition: 6% Rate Increase</th>
              <td style="padding: 10px; text-align: right;">$1,969,000</td>
              <td style="padding: 10px; text-align: right;">$2,391,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Tuition: Summer</th>
              <td style="padding: 10px; text-align: right;">$0</td>
              <td style="padding: 10px; text-align: right;">$1,194,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Other Tuition & Fees</th>
              <td style="padding: 10px; text-align: right;">$26,000</td>
              <td style="padding: 10px; text-align: right;">$477,000</td>
            </tr>

            <!-- TOTAL: Revenue -->
            <tr style="background-color: #EDF2F7; border-top: 2px solid #CBD5E0; border-bottom: 2px solid #CBD5E0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: bold;">Total Revenue/Sources Budget</th>
              <td style="padding: 10px; text-align: right; font-weight: bold;">$187,886,821</td>
              <td style="padding: 10px; text-align: right; font-weight: bold;">$184,268,821</td>
            </tr>

            <!-- Expenditures -->
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Prior Year Expenditure/Uses Budget</th>
              <td style="padding: 10px; text-align: right;">$175,270,821</td>
              <td style="padding: 10px; text-align: right;">$175,270,821</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">CSU Allocated Costs & Priorities</th>
              <td style="padding: 10px; text-align: right;">$9,558,000</td>
              <td style="padding: 10px; text-align: right;">$5,382,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Polytechnic Allocation</th>
              <td style="padding: 10px; text-align: right;">$3,729,000</td>
              <td style="padding: 10px; text-align: right;">$3,729,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Campus Costs & Priorities</th>
              <td style="padding: 10px; text-align: right;">$2,079,000</td>
              <td style="padding: 10px; text-align: right;">$1,875,000</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Base Reductions</th>
              <td style="padding: 10px; text-align: right; color: #C53030;">($2,613,000)</td>
              <td style="padding: 10px; text-align: right; color: #C53030;">($2,613,000)</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: normal;">Unallocated</th>
              <td style="padding: 10px; text-align: right;">$0</td>
              <td style="padding: 10px; text-align: right;">$625,000</td>
            </tr>

            <!-- TOTAL: Expenditures -->
            <tr style="background-color: #EDF2F7; border-top: 2px solid #CBD5E0; border-bottom: 2px solid #CBD5E0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: bold;">Total Expenditure/Uses Budget</th>
              <td style="padding: 10px; text-align: right; font-weight: bold;">$188,023,821</td>
              <td style="padding: 10px; text-align: right; font-weight: bold;">$184,268,821</td>
            </tr>

            <!-- SURPLUS/DEFICIT -->
            <tr style="background-color: #E2E8F0;">
              <th scope="row" style="padding: 10px; text-align: left; font-weight: bold;">Base Budget Surplus (Deficit)</th>
              <td style="padding: 10px; text-align: right; font-weight: bold; color: #C53030;">($137,000)</td>
              <td style="padding: 10px; text-align: right; font-weight: bold;">$0</td>
            </tr>
          </tbody>
        </mj-table>
        <mj-text>Dear Campus Community,</mj-text>
        <mj-text>We’re writing to share an update on our current financial picture and our plans for maintaining a sustainable budget in the coming years.</mj-text>


        <mj-text>Sincerely,<br></mj-text>
        <mj-image src="https://mailings.humboldt.edu/general/signatures/fisherMichael_signature.png" width="100px" alt="Michael Fisher Signature" align="left" />
        <mj-text>
          Michael Fisher <br>
          Vice President for Administrative Affairs and Chief Financial Officer
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 40px 0">
      <mj-column>
        <mj-image src="https://mailings.humboldt.edu/polytechnic/img/emailFooterDiamondH.png" alt="circle H graphic element" padding="0" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>